# ============================================================
# IA para Vida Real — variaveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores
# do seu projeto Supabase (Project Settings > API).
# ============================================================

# URL do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica (anon / publishable). Usada no client e no server
# para operacoes ligadas a sessao do usuario autenticado.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role (secreta). Usada APENAS no servidor, depois
# de validar o perfil do usuario, para operacoes que cruzam usuarios
# (professor lendo entregas de alunos, criacao de perfis, RPC de XP).
# NUNCA exponha esta chave no client nem versione em repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Avaliacao assistida por IA (Google Gemini) — opcional.
# Sem GEMINI_API_KEY o recurso fica desligado (falha fechado).
# ------------------------------------------------------------

# Chave da Generative Language API (Google AI Studio). Server-only.
GEMINI_API_KEY=

# Modelo a usar. Default: gemini-2.5-flash.
GEMINI_MODEL=

# Liga a sugestao de avaliacao por IA. Em producao exige "1";
# em dev/preview liga por padrao (desligavel com "0").
ENABLE_AI_EVALUATION=
